{
  "name": "agi-desktop",
  "private": true,
  "version": "0.1.22",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "test": "node --import tsx --test src/*.test.ts src/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "build:icons": "python3 ./scripts/generate_tauri_icons.py",
    "build:hostd": "bash ./scripts/build_hostd.sh",
    "sign:macos:setup": "bash ./scripts/setup_macos_local_codesign.sh",
    "sign:windows:prebundle": "pwsh ./scripts/sign_windows_artifacts.ps1 -Phase prebundle",
    "sign:windows:bundle": "pwsh ./scripts/sign_windows_artifacts.ps1 -Phase bundle",
    "tauri:dev": "npm run build:hostd && tauri dev",
    "tauri:build": "npm run build:hostd && tauri build",
    "tauri:build:linux": "bash ./scripts/build_linux_packages.sh"
  },
  "dependencies": {
    "@agi/frontend": "file:../../packages/frontend",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^1.24.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^8.1.5"
  }
}
